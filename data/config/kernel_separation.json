      "compare_kernel": {
        "default": 512,
        "range": [256, 512, 1024],
        "optimal_for_memory": 512
      }
    },
    "grid_size_calculation": {
      "method": "occupancy_based",
      "minimum_blocks_per_sm": 2,
      "target_occupancy": 0.80
    },
    "stream_configuration": {
      "concurrent_kernels": 3,
      "stream_priority": true,
      "overlap_computation": true
    }
  },

