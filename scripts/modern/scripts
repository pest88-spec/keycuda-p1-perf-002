#!/bin/bash
# Puzzle71Solver CUDA Technical Debt Elimination - Scripts Entry Point
# This file provides convenient access to all project scripts

set -euo pipefail

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print usage information
show_help() {
    cat << EOF
Puzzle71Solver Scripts - Technical Debt Elimination Framework

USAGE:
    scripts <command> [options]

DEVELOPMENT WORKFLOW:
    setup           Initialize development environment
    build           Build project with optimizations
    test            Run comprehensive test suite
    benchmark       Run performance benchmarks
    profile         Profile CUDA kernels
    clean           Clean build artifacts

AUTOMATION & CI/CD:
    validate        Validate code quality and performance
    deploy          Create deployment packages
    monitor         Set up performance monitoring
    health          Check system health

UTILITIES:
    env             Show environment information
    logs            View application logs
    config          Manage configuration
    docs            Generate documentation

OPTIONS:
    --help, -h          Show this help message
    --verbose, -v       Enable verbose output
    --version           Show version information

EXAMPLES:
    scripts setup                    # Initialize development environment
    scripts build --optimize         # Build with optimizations
    scripts benchmark --gpu rtx3090  # Benchmark specific GPU
    scripts validate --performance   # Validate performance targets

For detailed help on any command: scripts <command> --help
EOF
}

# Color print functions
print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if required command exists
check_command() {
    local cmd="$1"
    if ! command -v "$cmd" &> /dev/null; then
        print_error "Required command not found: $cmd"
        exit 1
    fi
}

# Validate environment
validate_environment() {
    print_info "Validating environment..."

    # Check basic commands
    check_command "cmake"
    check_command "make"

    # Check CUDA if available
    if command -v nvcc &> /dev/null; then
        print_info "CUDA found: $(nvcc --version | head -n1)"
    else
        print_warning "CUDA not found - some features may be unavailable"
    fi

    print_success "Environment validation completed"
}

# Main command dispatcher
main() {
    local command=""
    local args=()
    local verbose=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --help|-h)
                show_help
                exit 0
                ;;
            --verbose|-v)
                verbose=true
                shift
                ;;
            setup|build|test|benchmark|profile|clean|validate|deploy|monitor|health|env|logs|config|docs)
                command="$1"
                shift
                args=("$@")
                break
                ;;
            *)
                print_error "Unknown command: $1"
                show_help
                exit 1
                ;;
        esac
    done

    # Validate environment first
    validate_environment

    # Execute command if specified
    if [[ -n "$command" ]]; then
        local script_path="$SCRIPT_DIR/workflow/$command.sh"

        if [[ -f "$script_path" ]]; then
            print_info "Executing: $command"
            if [[ "$verbose" == true ]]; then
                set -x
            fi
            # shellcheck source=/dev/null
            source "$script_path" "${args[@]}"
        else
            print_error "Script not found: $script_path"
            exit 1
        fi
    else
        show_help
    fi
}

# Run main function with all arguments
main "$@"